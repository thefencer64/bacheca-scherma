# Config non sensibile per mailSend.js (sostituto dell'estensione
# deprecata firebase/firestore-send-email). Caricato automaticamente
# da Cloud Functions v2 al deploy.
#
# MAIL_TEMPLATES_COLLECTION: nome della collection Firestore dei template
#   Handlebars usata dall'estensione — confermato da Firebase Console >
#   Extensions > firestore-send-email > Configurazione > "Templates collection".
MAIL_TEMPLATES_COLLECTION=emailTemplates

# MAIL_DEFAULT_FROM: mittente usato quando il doc in mail/ non specifica
#   "from" (è sempre il caso qui: auth.js/admin.js non lo impostano mai).
#   Confermato da Firebase Console > Extensions > firestore-send-email >
#   Configurazione > "Default FROM address".
MAIL_DEFAULT_FROM=noreply@bachecascherma.it

# MAIL_DEFAULT_REPLY_TO: opzionale, stesso discorso per "Default REPLY-TO address".
MAIL_DEFAULT_REPLY_TO=
